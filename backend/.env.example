# Copy to .env for local use. Never commit the filled .env file.
# On a deployed backend, configure these in its hosting environment settings.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
# Optional upload cap in bytes; omit for the current unlimited local behavior.
# MAX_UPLOAD_BYTES=26214400
# Optional translation provider credentials, server-side only.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# Added automatically by Vercel when a private Blob store is connected.
# BLOB_READ_WRITE_TOKEN=
